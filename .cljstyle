; -*- mode: edn; -*-
{:rules {:indentation {:list-indent 1
                       :indents {with-temp-dir [[:block 1]]}}
         :blank-lines {:insert-padding? false}
         :types {:enabled? false}
         :namespaces {:indent-size 1}}
 :files {:ignore #{"target" ".clj-kondo"}}}
; vim:ft=clojure
