{:min-bb-version "1.13.224"
 :paths ["bb"]
 :deps {lread/status-line {:git/url "https://github.com/lread/status-line.git"
                           :sha "eace48e2e0fcc65a3986d696fb0b910fa5790a1c"}
        version-clj/version-clj {:mvn/version "2.0.3"}
        wevre/natural-compare {:mvn/version "0.0.10"}}
 :tasks
 {:cli helper.cli/base-opts
  clean         {:exec-fn clean/task         :doc "delete all build work"}
  download-deps {:exec-fn download-deps/task :doc "bring down Clojure deps"}
  dev-jvm       {:exec-fn dev-repl/task      :doc "launch jvm nREPL for development"}
  lint-kondo    {:exec-fn lint-kondo/task    :doc "lint with clj-kondo"}
  lint-cljstyle {:task lint-cljstyle/-main   :doc "lint with cljstyle"}
  test-clj      {:exec-fn test-clj/task      :doc "run tests against a version of Clojure"}
  test-bb       {:doc "run tests against babashka"
                 :extra-paths ["test" "test/resources"]
                 :extra-deps {com.github.liquidz/antq {:local/root "."}
                              io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                              nubank/matcher-combinators {:mvn/version "3.11.0"}
                              org.flatland/ordered {:mvn/version "1.15.12"}
                              lambdaisland/deep-diff2 {:mvn/version "2.14.235"}
                              metosin/malli {:mvn/version "0.20.2"}}
                 :requires ([cognitect.test-runner.api :as test-runner])
                 ;; aether-test needs the JVM, lein-plugin-test needs Leiningen
                 :task (test-runner/test {:dirs ["test"]
                                          :patterns ["^antq\\.(?!util\\.aether-test$|lein-plugin-test$).*-test$"]})}
  test-coverage {:exec-fn test-coverage/task :doc "generate code coverage reports Clojure tests"}
  jar           {:exec-fn jar/jar            :doc "generate antq jar"}
  uberjar       {:exec-fn jar/uberjar        :doc "generate antq uberjar"
                 :override-builtin true}
  install       {:exec-fn jar/install        :doc "install antq to local maven repository"}
  antq          {:task outdated/-main        :doc "run antq on antq"}
  docker-build  {:exec-fn docker/build       :doc "build docker image"}
  docker-antq   {:exec-fn docker/sources     :doc "run antq on against cwd from docker image"}}}
