{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/data.xml {:mvn/version "0.2.0-alpha11"}
  org.clojure/data.zip {:mvn/version "1.1.1"}
  org.clojure/tools.cli {:mvn/version "1.4.256"}
  org.clojure/core.async {:mvn/version "1.9.865"}
  org.clojure/tools.deps {:mvn/version "0.31.1646"}
  org.clojure/data.json {:mvn/version "2.5.2"}
  clj-commons/clj-yaml {:mvn/version "1.0.30"}
  version-clj/version-clj {:mvn/version "2.0.3"}
  rewrite-clj/rewrite-clj {:mvn/version "1.2.57"}
  com.github.liquidz/rewrite-indented {:mvn/version "0.2.44"}
  pogonos/pogonos {:mvn/version "0.2.1"}}

 :tools/usage
 {:ns-default antq.tool}

 :aliases
 {:1.11
  {:override-deps {org.clojure/clojure ^:antq/exclude {:mvn/version "1.11.4"}}}

  :dev
  {:extra-paths ["dev"
                 "test"
                 "test/resources"]
   :extra-deps {babashka/fs {:mvn/version "0.5.34"}
                babashka/process {:mvn/version "0.6.25"}
                nubank/matcher-combinators {:mvn/version "3.11.0"}
                org.flatland/ordered {:mvn/version "1.15.12"}
                metosin/malli ^{:antq/exclude "0.17.0"} {:mvn/version "0.20.1"}
                lambdaisland/kaocha {:mvn/version "1.91.1392"}
                lambdaisland/deep-diff2 {:mvn/version "2.14.235"}
                lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
   :jvm-opts ["-Dclojure.core.async.go-checking=true"]}

  :nop
  {:extra-deps {org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}}

  :cljstyle
  {:deps {mvxcvi/cljstyle {:mvn/version "0.17.642"}}
   :main-opts ["-m" "cljstyle.main"]}

  :clj-kondo
  {:deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts ["-m" "clj-kondo.main"]}
  
  :outdated
  {:main-opts ["-m" "antq.core"]}

  :test
  {:main-opts ["-m" "kaocha.runner"]}

  :build
  {:deps {com.github.liquidz/build.edn {:mvn/version "0.11.266"}}
   :ns-default build}

  ;; -X
  :latest
  {:extra-deps {org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}
   :exec-fn antq.core/latest}}}
